  "help": {
    "title": "Centro de Ayuda Contextual",
    "subtitle": "Información técnica y consejos de uso para esta sección.",
    "contexts": {
      "upload-documents": {
        "title": "Subir Documentos Técnicos",
        "content": "Puedes subir PDFs, imágenes y documentos Word. El sistema analizará automáticamente el contenido y lo indexará para búsquedas futuras.",
        "example": "Ej: Manual ARCA II, esquemas de conexionado, procedimientos de mantenimiento",
        "tips": "Usa archivos en buen estado (legibles, bien escaneados),Nombres descriptivos ayudan a la búsqueda (ej: 'Manual_ARCA2_v3.pdf'),Máximo 50MB por archivo,PDFs con texto OCR se indexan mejor",
        "learnMore": {
          "label": "Ver guía de formatos",
          "href": "/ayuda/formatos-soportados"
        }
      },
      "search-query": {
        "title": "Cómo Hacer Mejores Búsquedas",
        "content": "Escribe preguntas en lenguaje natural, como si hablaras con un técnico. El sistema buscará en todos tus documentos automáticamente.",
        "example": "✅ Buenos ejemplos:\n• ¿Cuál es el torque del motor principal?\n• Procedimiento de calibración de puertas\n• ¿Qué significa código E07?",
        "tips": "Sé específico: incluye el modelo si es importante,Usa términos técnicos exactos,Puedes hacer seguimiento: '¿Y el tiempo de espera?',Si no encuentras respuesta, intenta reformular",
        "learnMore": {
          "label": "Tips avanzados de búsqueda",
          "href": "/ayuda/busquedas-avanzadas"
        }
      },
      "report-hub": {
        "title": "Generación de Informes",
        "content": "Crea documentos técnicos PDF basados en el análisis de tus activos de conocimiento.",
        "tips": "Elige una plantilla según el tipo de análisis que necesites,Filtra por fecha para analizar periodos específicos,Los informes incluyen citas directas a los manuales"
      },
      "upload-dropzone": {
        "title": "Bóveda de Documentos",
        "content": "Arrastra archivos aquí para que el RAG los procese y puedas consultarlos.",
        "tips": "Soportamos PDFs técnicos, planos y manuales,El procesado suele tardar entre 30 y 90 segundos"
      },
      "confidence-scores": {
        "title": "Niveles de Confianza",
        "content": "Indica qué tan seguro está el sistema de que la respuesta es exacta según los documentos.",
        "tips": "Alta: Encontrado literalmente en el texto,Media: Inferido de múltiples fragmentos,Baja: Información vaga o ausente"
      },
      "audit-logs": {
        "title": "Registro de Auditoría",
        "content": "Trazabilidad total de cada acción realizada en la plataforma para cumplimiento normativo.",
        "tips": "Filtra por 'ERROR' para problemas críticos,Usa el correlationId para rastrear acciones de extremo a extremo"
      },
      "rag_confidence": {
        "title": "Score de Confianza de la IA",
        "content": "Este porcentaje refleja la certidumbre del Agente al analizar los patrones técnicos detectados en el pedido frente a los manuales activos.",
        "example": "Un score del 95% indica que el sistema ha encontrado citas directas y unívocas. Un score del 40% sugiere que la documentación es ambigua o parcial.",
        "tips": "Si la confianza es < 60%, revisa las advertencias en las Recomendaciones Técnicas.,Asegúrate de que el documento técnico correcto esté seleccionado como fuente."
      },
      "labs-hub": {
        "title": "Labs & Zona Demo",
        "content": "Espacio de pruebas para nuevas funcionalidades e industrias experimentales.",
        "tips": "Los datos generados aquí no afectan a producción.,Ideal para demostraciones a clientes potenciales."
      }
    }
