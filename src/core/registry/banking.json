{
    "id": "banking-ontology-synthetic",
    "name": "Banking & Compliance (Synthetic)",
    "version": "1.0.0",
    "metadata": {
        "synthetic": true,
        "description": "Plantilla sintética para pruebas de vertical bancaria"
    },
    "entities": [
        {
            "name": "file",
            "plural": "files",
            "slug": "files",
            "icon": "Briefcase",
            "fields": [
                {
                    "key": "fileId",
                    "label": "File ID",
                    "type": "string",
                    "required": true,
                    "searchable": true,
                    "ui": {
                        "order": 1,
                        "width": "w-32"
                    }
                },
                {
                    "key": "clientId",
                    "label": "Client ID",
                    "type": "string",
                    "required": true,
                    "ui": {
                        "order": 2
                    }
                },
                {
                    "key": "riskLevel",
                    "label": "Risk Level",
                    "type": "select",
                    "options": [
                        "LOW",
                        "MEDIUM",
                        "HIGH",
                        "CRITICAL"
                    ],
                    "ui": {
                        "order": 3
                    }
                },
                {
                    "key": "kycStatus",
                    "label": "KYC Status",
                    "type": "select",
                    "options": [
                        "PENDING",
                        "APPROVED",
                        "REJECTED"
                    ],
                    "ui": {
                        "order": 4
                    }
                }
            ],
            "api": {
                "list": "/api/banking/files",
                "detail": "/api/banking/files/:id",
                "analyze": "/api/banking/analyze"
            }
        }
    ]
}